pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '460249938865'
        ECS_CLUSTER    = 'project-poc-ecs-cluster'

        FRONTEND_REPO  = 'project-poc-frontend'
        BACKEND_REPO   = 'project-poc-backend'

        FRONTEND_SERVICE = 'project-poc-frontend-service'
        BACKEND_SERVICE  = 'project-poc-backend-service'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Application') {
            steps {
                sh '''
                    echo "Checking frontend dependencies..."
                    test -f frontend/package-lock.json

                    echo "Checking backend dependencies..."
                    test -f backend/package-lock.json

                    echo "Checking Dockerfiles..."
                    test -f frontend/Dockerfile
                    test -f backend/Dockerfile

                    echo "Application structure validated."
                '''
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarScanner'
                    def sonarBranch = (env.CHANGE_BRANCH ?: env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'main')
                        .replaceFirst('^origin/', '')
                        .replaceFirst('^refs/heads/', '')
                    def sonarBranchArg = sonarBranch == 'main' ? '' : "-Dsonar.branch.name=${sonarBranch}"
                    def qualityGateWait = sonarBranch == 'main' ? 'true' : 'false'


                    withSonarQubeEnv('SonarQube-Cloud') {
                        // Keep the scanner invocation on one shell line to avoid
                        // accidental command splitting in Jenkins/Groovy.
                        sh """
                            set -eu
                            "${scannerHome}/bin/sonar-scanner" -Dsonar.projectKey=vibhord-work_HospitalDBMS-DevOps -Dsonar.organization=vibhord-work ${sonarBranchArg} -Dsonar.sources=backend,frontend/src -Dsonar.tests=backend/tests -Dsonar.test.inclusions=backend/tests/**/*.js -Dsonar.exclusions=backend/tests/**,backend/**/*.test.js,frontend/src/**/*.test.jsx,frontend/src/test/** -Dsonar.host.url=https://sonarcloud.io -Dsonar.qualitygate.wait=${qualityGateWait} -Dsonar.qualitygate.timeout=300
                        """
                    }
                }
            }
        }


        stage('SonarCloud Security Report') {
            steps {
                script {
                    def reportBranch = (env.CHANGE_BRANCH ?: env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'main')
                        .replaceFirst('^origin/', '')
                        .replaceFirst('^refs/heads/', '')
                    def reportUrl = reportBranch == 'main'
                        ? 'https://sonarcloud.io/dashboard?id=vibhord-work_HospitalDBMS-DevOps'
                        : "https://sonarcloud.io/dashboard?id=vibhord-work_HospitalDBMS-DevOps&branch=${java.net.URLEncoder.encode(reportBranch, 'UTF-8')}"
                    echo "SonarCloud SAST analysis completed. Security report: ${reportUrl}"
                    if (reportBranch == 'main') {
                        echo 'The native SonarCloud Quality Gate is enforced during main-branch analysis.'
                    } else {
                        echo 'Feature-branch report is available in SonarCloud; native branch Quality Gate is unavailable on the current organization plan.'
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    docker build \
                      --build-arg NGINX_CONFIG=nginx.aws.conf \
                      -t hospital-frontend:build-${BUILD_NUMBER}-${GIT_COMMIT} \
                      ./frontend

                    docker build \
                      -t hospital-backend:build-${BUILD_NUMBER}-${GIT_COMMIT} \
                      ./backend
                '''
            }
        }

        stage('Trivy Image CVE Scan') {
            steps {
                sh '''
                    set -eu
                    mkdir -p reports
                    TRIVY_IMAGE="aquasec/trivy:0.68.2"
                    FRONTEND_IMAGE="hospital-frontend:build-${BUILD_NUMBER}-${GIT_COMMIT}"
                    BACKEND_IMAGE="hospital-backend:build-${BUILD_NUMBER}-${GIT_COMMIT}"

                    trivy_scan() {
                        FORMAT="$1"
                        OUTPUT="$2"
                        TARGET="$3"
                        docker run --rm \\
                          -v /var/run/docker.sock:/var/run/docker.sock \\
                          -v "$PWD:/work" -w /work \\
                          "$TRIVY_IMAGE" image --scanners vuln \\
                          --format "$FORMAT" --output "$OUTPUT" --exit-code 0 "$TARGET"
                    }

                    echo "Generating complete Trivy JSON and table reports..."
                    trivy_scan json reports/trivy-frontend.json "$FRONTEND_IMAGE"
                    trivy_scan table reports/trivy-frontend.txt "$FRONTEND_IMAGE"
                    trivy_scan json reports/trivy-backend.json "$BACKEND_IMAGE"
                    trivy_scan table reports/trivy-backend.txt "$BACKEND_IMAGE"

                    echo "Enforcing HIGH/CRITICAL vulnerability gate..."
                    set +e
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \\
                      "$TRIVY_IMAGE" image --scanners vuln --severity HIGH,CRITICAL \\
                      --exit-code 1 "$FRONTEND_IMAGE"
                    FRONTEND_SCAN_STATUS=$?
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \\
                      "$TRIVY_IMAGE" image --scanners vuln --severity HIGH,CRITICAL \\
                      --exit-code 1 "$BACKEND_IMAGE"
                    BACKEND_SCAN_STATUS=$?
                    set -e

                    if [ "$FRONTEND_SCAN_STATUS" -ne 0 ] || [ "$BACKEND_SCAN_STATUS" -ne 0 ]; then
                        echo "Trivy gate failed. Full reports are archived by the pipeline post action."
                        exit 1
                    fi
                    echo "Trivy vulnerability gate passed."
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'reports/trivy-*.json,reports/trivy-*.txt', fingerprint: true, allowEmptyArchive: true
                }
            }
        }

        stage('Push Images to ECR') {
            steps {
                sh '''
                    set -eu

                    REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                    aws ecr get-login-password --region "$AWS_REGION" | \
                      docker login --username AWS --password-stdin "$REGISTRY"

                    docker tag hospital-frontend:build-${BUILD_NUMBER}-${GIT_COMMIT} \
                      "$REGISTRY/$FRONTEND_REPO:build-${BUILD_NUMBER}-${GIT_COMMIT}"

                    docker tag hospital-backend:build-${BUILD_NUMBER}-${GIT_COMMIT} \
                      "$REGISTRY/$BACKEND_REPO:build-${BUILD_NUMBER}-${GIT_COMMIT}"

                    docker push "$REGISTRY/$FRONTEND_REPO:build-${BUILD_NUMBER}-${GIT_COMMIT}"
                    docker push "$REGISTRY/$BACKEND_REPO:build-${BUILD_NUMBER}-${GIT_COMMIT}"
                '''
            }
        }

        stage('Record Approved Images') {
            steps {
                sh '''
                    set -eu

                    IMAGE_TAG="build-${BUILD_NUMBER}-${GIT_COMMIT}"
                    REGISTRY="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                    FRONTEND_DIGEST=$(aws ecr describe-images \
                      --repository-name "$FRONTEND_REPO" \
                      --image-ids imageTag="$IMAGE_TAG" \
                      --region "$AWS_REGION" \
                      --query 'imageDetails[0].imageDigest' \
                      --output text)

                    BACKEND_DIGEST=$(aws ecr describe-images \
                      --repository-name "$BACKEND_REPO" \
                      --image-ids imageTag="$IMAGE_TAG" \
                      --region "$AWS_REGION" \
                      --query 'imageDetails[0].imageDigest' \
                      --output text)

                    case "$FRONTEND_DIGEST" in
                      sha256:*) ;;
                      *) echo "Invalid frontend digest"; exit 1 ;;
                    esac

                    case "$BACKEND_DIGEST" in
                      sha256:*) ;;
                      *) echo "Invalid backend digest"; exit 1 ;;
                    esac

                    jq -n \
                      --arg commit "$GIT_COMMIT" \
                      --arg tag "$IMAGE_TAG" \
                      --arg frontend "$REGISTRY/$FRONTEND_REPO@$FRONTEND_DIGEST" \
                      --arg backend "$REGISTRY/$BACKEND_REPO@$BACKEND_DIGEST" \
                      '{
                        git_commit: $commit,
                        image_tag: $tag,
                        frontend_image: $frontend,
                        backend_image: $backend
                      }' > approved-images.json

                    cat approved-images.json
                '''

                archiveArtifacts artifacts: 'approved-images.json', fingerprint: true
            }
        }
        stage('Trigger CD Pipeline') {
            steps {
                script {
                    def frontendImage = sh(
                        script: "jq -r '.frontend_image' approved-images.json",
                        returnStdout: true
                    ).trim()

                    def backendImage = sh(
                        script: "jq -r '.backend_image' approved-images.json",
                        returnStdout: true
                    ).trim()

                    if (!frontendImage || !backendImage ||
                        frontendImage == 'null' || backendImage == 'null') {
                        error('Approved image manifest is invalid.')
                    }

                    build job: 'pipeline-cd',
                        wait: true,
                        propagate: true,
                        parameters: [
                            string(name: 'FRONTEND_IMAGE', value: frontendImage),
                            string(name: 'BACKEND_IMAGE', value: backendImage),
                            string(name: 'CI_JOB_NAME', value: env.JOB_NAME),
                            string(name: 'CI_BUILD_NUMBER', value: env.BUILD_NUMBER),
                            string(name: 'CI_COMMIT', value: env.GIT_COMMIT)
                        ]
                }
            }
        }

    }

    post {
        always {
            archiveArtifacts artifacts: 'reports/trivy-*.json,reports/trivy-*.txt', fingerprint: true, allowEmptyArchive: true
        }

        success {
            echo 'Jenkins pipeline completed successfully.'
        }

        failure {
            echo 'Jenkins CI pipeline failed. Check stage logs.'
        }
    }
}
